{
  "name": "worktree-x-v8",
  "version": "8.0.0",
  "description": "Không gian điều hành công việc, quản lý dự án và phân quyền cục bộ (Local-First Workspace)",
  "main": "index.html",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "npm run bundle",
    "check": "npm run check:syntax && npm run check:architecture && npm run test:state && npm run test:employees && npm run test:visibility && npm run test:notifications && npm run test:server && npm run test:smoke",
    "check:syntax": "node scripts/check-js-syntax.js",
    "check:architecture": "node scripts/check-architecture.js",
    "test:state": "node --test tests/app-state.test.js",
    "test:employees": "node --test tests/employee-service.test.js",
    "test:visibility": "node --test tests/task-visibility.test.js",
    "test:notifications": "node --test tests/notification-push-contract.test.js",
    "test:server": "node --test tests/server.test.js",
    "test:smoke": "node scripts/smoke-test.js",
    "bundle": "node -e \"const fs=require('fs');let h=fs.readFileSync('index.html','utf8');h=h.replace('<link rel=\\\"stylesheet\\\" href=\\\"css/style.css\\\">','<style>\\n'+fs.readFileSync('css/style.css','utf8')+'\\n</style>');h=h.replace('<script src=\\\"js/core.js\\\"></script>','<script>\\n'+fs.readFileSync('js/core.js','utf8')+'\\n\\n'+fs.readFileSync('js/access.js','utf8')+'\\n\\n'+fs.readFileSync('js/mobile.js','utf8')+'\\n</script>');h=h.replace('<script src=\\\"js/access.js\\\"></script>','').replace('<script src=\\\"js/mobile.js\\\"></script>','');fs.writeFileSync('WorkTree.html',h,'utf8');console.log('WorkTree.html bundled successfully!');\""
  },
  "keywords": [
    "worktree",
    "project-management",
    "local-first",
    "kanban",
    "gantt",
    "webcrypto",
    "productivity"
  ],
  "author": "Four Group",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0"
  },
  "devDependencies": {}
}
