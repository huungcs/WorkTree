# Supabase Project Configuration
# Lấy từ: Supabase Dashboard -> Project Settings -> API

# URL project Supabase của bạn
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Publishable Key mới (khuyến nghị cho frontend) hoặc Anon Key
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# SUPABASE_ANON_KEY=your_legacy_anon_key_here

# TUYỆT ĐỐI KHÔNG đưa Secret Key (sb_secret_... hoặc service_role key) vào frontend!
